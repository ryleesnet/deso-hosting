# Alternative: Nginx reverse proxy for Proxmox VNC WebSocket
# Use this if the Node.js proxy keeps failing. Run nginx in front of your app.
#
# 1. Install nginx: apt install nginx
# 2. Copy this to /etc/nginx/sites-available/deso-vnc
# 3. Edit PROXMOX_IP (e.g. 192.168.1.10 or pve01.home.rylees.net)
# 4. ln -s /etc/nginx/sites-available/deso-vnc /etc/nginx/sites-enabled/
# 5. nginx -t && systemctl reload nginx
#
# Then change your app to return the nginx proxy URL instead of the Node proxy.
# Note: You'll need to pass auth (cookie or token) - nginx can't easily add
# per-request headers from a ticket. This example assumes you've set PVEAuthCookie
# via a prior login to Proxmox on the same domain.

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 3001;  # Different port so it doesn't conflict with Next.js
    server_name localhost;

    location /api/proxmox-ws {
        proxy_pass https://PROXMOX_IP:8006;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_ssl_verify off;
        proxy_read_timeout 86400;
    }
}
