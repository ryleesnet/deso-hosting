# DeSo Hosting — environment template
# Copy to `.env` in this folder (`npm run dev` / `server.js` loads `.env`).

# --- Firebase Firestore (required) ---
# Option A: full JSON (one line in .env, or use a .env editor that supports multiline)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n....\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com",...}

# Option B: separate fields (private_key may use \n for newlines)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option C: path to service account file
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# --- Public IP pool (Firestore `public_ips`; cloud-init network) ---
# PUBLIC_IP_POOL_CIDR=68.122.49.128/25
# PUBLIC_IP_GATEWAY=68.122.49.254
# PUBLIC_IP_PREFIX_LEN=32
# PUBLIC_IP_DNS=1.1.1.1,8.8.8.8
# PUBLIC_IP_EXTRA_EXCLUDE=68.122.49.200,68.122.49.201

# --- Pricing (USD catalogue → DeSo at pay time) ---
# Optional: USD per 1 DESO. If unset, server reads the rate from your DeSo node (`get-exchange-rate`).
# DESO_USD_PRICE=12.50
# Optional: custom node base URL (default https://node.deso.org)
# DESO_NODE_URI=https://node.deso.org

# Optional: accept renewal POST without verifying on-chain tx (local dev only)
# BILLING_SKIP_TX_VERIFY=true

# --- Proxmox, DeSo, admin keys, etc. — see README.md ---

# Required: HMAC secret used to sign short-lived VNC console tokens that the
# WebSocket proxy at /api/proxmox-ws verifies. Generate with `openssl rand -hex 32`.
# CONSOLE_TOKEN_SECRET=replace-with-32-byte-random
# Optional: daily job — POST /api/cron/billing-dunning with Authorization: Bearer <secret>
# marks overdue subscriptions past_due, then suspends active VPS (ACPI shutdown) after this many days past nextPaymentAt.
# CRON_SECRET=long-random-string
# BILLING_SUSPEND_AFTER_DAYS_PAST_DUE=30

# Optional: POST /api/cron/purge-cancelled-orders — delete Firestore `orders` docs in `cancelled`
# status after this many days (subscriptions are deleted immediately on cancel).
# CANCELLED_ORDER_RETENTION_DAYS=90

# --- Private VM-to-VM LAN (Firestore `user_private_networks`, second virtio NIC on Proxmox) ---
# Use a VLAN-aware bridge on the host; each DeSo user gets one VLAN tag shared by their VPS.
# PROXMOX_PRIVATE_LAN_BRIDGE=vmbr0
# Prefix length for 10.200.0.x addresses in cloud-init ipconfig1 (default 24).
# PRIVATE_LAN_PREFIX_LEN=24
