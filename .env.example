# DeSo Hosting — environment template
# Copy to `.env` in this folder (`npm run dev` / `server.js` loads `.env`).

# --- Firebase Firestore (required) ---
# Option A: full JSON (one line in .env, or use a .env editor that supports multiline)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n....\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com",...}

# Option B: separate fields (private_key may use \n for newlines)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option C: path to service account file
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# --- Public IP pool (Firestore `public_ips`; cloud-init network) ---
# PUBLIC_IP_POOL_CIDR=68.122.49.128/25
# PUBLIC_IP_GATEWAY=68.122.49.254
# PUBLIC_IP_PREFIX_LEN=32
# PUBLIC_IP_DNS=1.1.1.1,8.8.8.8
# PUBLIC_IP_EXTRA_EXCLUDE=68.122.49.200,68.122.49.201

# --- Pricing (USD catalogue → DeSo at pay time) ---
# Optional: USD per 1 DESO. If unset, server reads the rate from your DeSo node (`get-exchange-rate`).
# DESO_USD_PRICE=12.50
# Optional: custom node base URL (default https://node.deso.org)
# DESO_NODE_URI=https://node.deso.org

# Optional: accept renewal POST without verifying on-chain tx (local dev only)
# BILLING_SKIP_TX_VERIFY=true

# Fallback host-wide QEMU template catalogue JSON when Firestore collection `os_templates` is empty
# and orders have no OS override (each item `{ "id","label","templateVmid" }`; ids start with a letter).
# Preferred: Admin → OS templates (global).
# TEMPLATE_CATALOG_JSON=[{"id":"debian","label":"Debian 12","templateVmid":9000}]

# --- Proxmox, DeSo, admin keys, etc. — see README.md ---
# Optional fallbacks when Admin → Proxmox host defaults fields are blank.
# PROXMOX_DEFAULT_NODE=pve
# PROXMOX_DISK_STORAGE=SAN_HDD
# PROXMOX_BACKUP_STORAGE=SAN_HDD
# PROXMOX_RESTORE_TASK_TIMEOUT_MS=7200000
# PROXMOX_AUTO_PLACE_VMS=0

# Required: HMAC secret used to sign short-lived VNC console tokens that the
# WebSocket proxy at /api/proxmox-ws verifies. Generate with `openssl rand -hex 32`.
# CONSOLE_TOKEN_SECRET=replace-with-32-byte-random
# Optional: daily job — POST /api/cron/billing-dunning with Authorization: Bearer <secret>
# marks overdue subscriptions past_due, then suspends active VPS (ACPI shutdown) after this many days past nextPaymentAt.
# CRON_SECRET=long-random-string
# BILLING_SUSPEND_AFTER_DAYS_PAST_DUE=30
# BILLING_DUNNING_INTERVAL_MS=3600000
# BILLING_DUNNING_MIN_INTERVAL_MS=300000
# BILLING_DUNNING_DISABLE=1

# DeSo DM billing reminders
# Owner-key mode: set DESO_BILLING_DM_SENDER_SEED_HEX to the owner account seed.
# Derived-key mode (recommended): derived seed + owner public key + messaging key:
# DESO_BILLING_DM_SENDER_SEED_HEX=64-char-derived-key-seed
# DESO_BILLING_DM_SENDER_OWNER_PUBLIC_KEY=BC1...  # main account with DESO balance
# DESO_BILLING_DM_OWNER_SEED_HEX=64-char-owner-seed  # OR set messaging key directly:
# DESO_BILLING_DM_MESSAGING_PRIVATE_KEY_HEX=64-char-hex  # deriveAccessGroupKeyPair(ownerSeed, default-key)
# Legacy alias: DESO_BILLING_DM_SENDER_PUBLIC_KEY = owner public key in derived-key mode
# APP_PUBLIC_URL=https://your-host.example.com

# Optional: POST /api/cron/purge-cancelled-orders — delete Firestore `orders` docs in `cancelled`
# status after this many days (subscriptions are deleted immediately on cancel).
# CANCELLED_ORDER_RETENTION_DAYS=90

# --- Private VM-to-VM LAN (Firestore `user_private_networks`, second virtio NIC on Proxmox) ---
# Use a VLAN-aware bridge on the host; each DeSo user gets one VLAN tag shared by their VPS.
# PROXMOX_PRIVATE_LAN_BRIDGE=vmbr0
# Prefix length for 10.200.0.x addresses in cloud-init ipconfig1 (default 24).
# PRIVATE_LAN_PREFIX_LEN=24

# --- PayPal (optional; enables auto-renewing PayPal subscriptions alongside DESO/dUSDC) ---
# Set to "sandbox" for testing or "live" for production. Controls which of the credential
# sets below the server uses and which PayPal API base URL it hits.
# PAYPAL_ENV=sandbox
#
# Server-side credentials from developer.paypal.com > Apps & Credentials. Create one REST API
# app per environment with "Subscriptions" enabled, then paste each app's Client ID + Secret
# below. The webhook IDs are shown after you register a webhook that POSTs to
# `${APP_PUBLIC_URL}/api/paypal/webhook` for the events documented in the PayPal integration.
# PAYPAL_SANDBOX_CLIENT_ID=
# PAYPAL_SANDBOX_CLIENT_SECRET=
# PAYPAL_SANDBOX_WEBHOOK_ID=
# PAYPAL_LIVE_CLIENT_ID=
# PAYPAL_LIVE_CLIENT_SECRET=
# PAYPAL_LIVE_WEBHOOK_ID=
#
# Client-side (public) toggle. Any truthy value enables the PayPal option in the UI. The actual
# `client-id` the JS SDK loads with is fetched from `/api/paypal/config` (which picks the correct
# id for the current PAYPAL_ENV), so a stale or mismatched value here just controls visibility —
# it can't break checkout with a sandbox/live mismatch anymore. Set it to the CLIENT_ID for the
# current PAYPAL_ENV if you prefer explicit configuration.
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=
#
# Surcharge added on top of the catalog USD price for every PayPal charge (both the initial
# order and every auto-renew). Defaults below match PayPal's US business rate (3.49% + $0.49).
# Set both to `0` to absorb the fee.
# PAYPAL_SURCHARGE_PERCENT=3.49
# PAYPAL_SURCHARGE_FIXED_CENTS=49
